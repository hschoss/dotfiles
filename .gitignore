# Allowlist model: everything is ignored by default. Opt files in with
# a `!` rule. A secret dropped into the tree cannot sneak into a commit
# just because its name is new — the only way to track it is to add it
# here deliberately.
#
# Keep this list in sync with `git ls-files`.

/*
!/.gitignore
!/.bash_profile
!/.bashrc
!/.inputrc
!/.tmux.conf
!/.vimrc
!/LICENSE.md
!/README.md
!/SECURITY.md

# Top-level directories that hold tracked files. The entries under them
# selectively allowlist individual files.
!/bash/
!/git/
!/scripts/
!/server/
!/shell/
!/tmux/
!/vim/

bash/*
!bash/plugins.bash
!bash/prompt.bash
!bash/settings.bash

git/*
!git/.config/
git/.config/*
!git/.config/gh/
git/.config/gh/*
!git/.config/gh/config.yml
!git/.config/git/
git/.config/git/*
!git/.config/git/config
!git/.config/git/ignore

scripts/*
!scripts/check.sh
!scripts/install-common.sh
!scripts/install-dev.sh
!scripts/install-server.sh
!scripts/unstow-all.sh
!scripts/hooks/
scripts/hooks/*
!scripts/hooks/pre-commit
!scripts/hooks/pre-push

server/*
!server/README.md

shell/*
!shell/aliases.sh
!shell/bootstrap.sh
!shell/dircolors.elflord
!shell/dircolors.solarized
!shell/external.sh
!shell/functions.sh

# tmux/ and vim/ are stow package roots that currently hold no files.
# Keep them tracked as directories.

# Belt-and-braces denylist in case something slips the allowlist above:
# any file matching these names is still refused by name.
*.key
*.pem
*.p12
*.pfx
*.jks
*.keystore
*.agekey
*token*
*secret*
*credential*
*apikey*
*.env
.env.*
.netrc
.npmrc
.pypirc
id_rsa*
id_ed25519*
id_ecdsa*
hosts.yml
rclone.conf
auth.yml
keys.txt
cookie
.git-credentials
*.ovpn
wg*.conf
*.wg
*.enc
*.sqlite
*.db
*.dump
*.sql
*.bak
*.backup
*.log
*.tmp
*.swp
*.swo
*~
